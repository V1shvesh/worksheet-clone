{
  "name": "@worksheet-clone/server",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:server": "vitest run -c vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.0.0",
    "@hocuspocus/server": "^4.8.0",
    "@worksheet-clone/shared": "workspace:*",
    "argon2": "^0.45.1",
    "crossws": "^0.4.17",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.1.0",
    "pg": "^8.23.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.8.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@worksheet-clone/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "ws": "^8.22.1"
  }
}
